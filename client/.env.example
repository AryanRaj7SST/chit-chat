VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Public S3-compatible storage origin used by npm run configure:csp before deployment.
CSP_S3_ORIGIN=https://your-project-ref.storage.supabase.co
# Optional Supabase project origin for APIs or SDKs used directly by the client.
CSP_SUPABASE_ORIGIN=https://your-project-ref.supabase.co
# Public R2 endpoint alternative when using R2 instead of Supabase Storage.
CSP_R2_ORIGIN=https://your-account-id.r2.cloudflarestorage.com
# On Vercel, use your actual Render HTTPS origin:
# VITE_API_URL must end with /api; VITE_SOCKET_URL must have no /api path.
# VITE_* values are public build-time settings. Never put secrets here.

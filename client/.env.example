VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Public R2 endpoint origin used by npm run configure:csp before deployment.
CSP_R2_ORIGIN=https://your-account-id.r2.cloudflarestorage.com
# On Vercel, use your actual Render HTTPS origin:
# VITE_API_URL must end with /api; VITE_SOCKET_URL must have no /api path.
# VITE_* values are public build-time settings. Never put secrets here.

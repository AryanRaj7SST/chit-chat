# Local port. Render supplies PORT automatically; do not override it there.
PORT=5000
NODE_ENV=development
# Production: use the Atlas database user's URI with /mern-chat before '?'.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mern-chat?retryWrites=true&w=majority
# Set a long, random secret in Render, not in this example or the client.
JWT_SECRET=
# Comma-separated frontend origins. Whitespace/trailing slashes are normalized.
CLIENT_URL=http://localhost:5173
# Production: set NODE_ENV=production and CLIENT_URL to your actual Vercel URL.
# To allow local + hosted clients, list both exact origins separated by a comma.

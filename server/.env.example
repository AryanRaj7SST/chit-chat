# Local port. Render supplies PORT automatically; do not override it there.
PORT=5000
NODE_ENV=development
# Production: use the Atlas database user's URI with /mern-chat before '?'.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mern-chat?retryWrites=true&w=majority
# Set a long, random secret in Render, not in this example or the client.
JWT_SECRET=
# 32 random bytes encoded as base64. Backend only; required in production.
# npm run key:create writes a new local key privately when none exists.
# Never change an existing key without a separate re-encryption plan.
MESSAGE_ENC_KEY=
# Comma-separated frontend origins. Whitespace/trailing slashes are normalized.
CLIENT_URL=http://localhost:5173
# Production: set NODE_ENV=production and CLIENT_URL to your actual Vercel URL.
# To allow local + hosted clients, list both exact origins separated by a comma.

# Local is development-only. Production requires a private R2 or S3-compatible bucket.
STORAGE_DRIVER=local
# Local signed-link origin, including the server port (no /api).
PUBLIC_API_URL=http://localhost:5000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# S3-compatible settings (when STORAGE_DRIVER=s3), for example Supabase Storage.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional development-only edit-window override for time-boundary tests.
# Production always uses 900000 ms (15 minutes), regardless of this value.
MESSAGE_EDIT_WINDOW_MS=900000
